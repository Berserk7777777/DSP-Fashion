!/pyproject.toml
!/SERVER_DEPLOYMENT.md
!/UPLOAD_MANIFEST.json
!/environments/
!/scripts/
!/DiFashion-main/
!/DualFashion-main/
!/fashion_psp/
!/FashionDPO-main/

