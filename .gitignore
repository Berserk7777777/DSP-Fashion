**/.git/
**/__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
node_modules/

